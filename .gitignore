# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local secrets and environment configuration
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# Generated runtime state and personal data
logs/
memory/
voice_profiles/
knowledge/
library/books/

# Downloaded models, caches, and local runtimes
models/
.cache/
runtime/

# Build/package output
build/
dist/
*.egg-info/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local backups
*.bak
*.bak_*
# JARVIS Memory 1.0 source package
# Runtime/personal memory remains ignored; only source code below is tracked.
!jarvis_core/memory/
jarvis_core/memory/*
!jarvis_core/memory/*.py

# Integrated WebJarvis release boundary

# Web runtime/personal state stays local and untracked.
jarvis_web/.venv/
jarvis_web/.pytest_cache/
jarvis_web/.cache/
jarvis_web/**/__pycache__/
jarvis_web/**/node_modules/
jarvis_web/data/
jarvis_web/logs/
jarvis_web/run/
jarvis_web/.env
jarvis_web/web/*.tsbuildinfo

# The built WebJarvis frontend is part of the immutable release.
!jarvis_web/web/dist/
!jarvis_web/web/dist/**
